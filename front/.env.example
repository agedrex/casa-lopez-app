# Copy to .env.local for local development. Never commit real values.

# Postgres used by Better Auth (tables in schema `public`). Same database as the API.
# Use the plain postgresql:// scheme (the `+psycopg` driver suffix is for the backend only).
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE

# Long random string; generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of this frontend, no trailing slash (the origin Better Auth trusts).
BETTER_AUTH_URL=http://localhost:3000

# Server-only base URL of the costing API (never exposed to the browser).
API_URL=http://127.0.0.1:8000

# Only for `pnpm seed:user`: password of contacto@agedrex.com. Required by the script.
SEED_USER_PASSWORD=
